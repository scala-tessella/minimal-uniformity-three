    family-names: Càllisto
    orcid: https://orcid.org/0009-0009-1215-3278
    email: mario.callisto@gmail.com
    alias: mcallisto
license: Apache-2.0
repository-code: https://github.com/scala-tessella/minimal-uniformity-three
url: https://github.com/scala-tessella/minimal-uniformity-three
version: 0.1.0
date-released: '2026-08-01'
# Version DOI of this release — the one to cite. Zenodo mints it when the release is published, so
# it cannot be present in the tree that release archives; it is recorded here, with the concept DOI
# in `identifiers`, in the first commit after the tag.
keywords:
  - tilings
  - tessellations
  - unit-edge polygons
  - minimal uniformity
  - k-uniform tilings
  - Delaney-Dress symbols
  - exact arithmetic
  - DRAT
  - formal verification
  - reproducibility
  - Scala
